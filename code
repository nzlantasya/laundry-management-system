# ================= TRANSACTIONS =================
def view_transactions():
    conn = get_connection()
    cur = conn.cursor(dictionary=True)
    cur.execute("""
        SELECT t.transaction_id, c.name AS customer, p.package_name, t.weight_kg, t.total_price,
               t.date_in, t.date_out, t.status, u.username AS staff
        FROM transactions t
        JOIN customers c ON t.customer_id=c.customer_id
        JOIN packages p ON t.package_id=p.package_id
        JOIN users u ON t.input_user_id=u.user_id
    """)
    rows = cur.fetchall()
    cur.close()
    conn.close()

    print("\n--- Transactions ---")
    for r in rows:
        print(f"{r['transaction_id']:>3} | {r['customer']:<12} | {r['package_name']:<12} | {r['weight_kg']}kg | Rp{r['total_price']} | {r['date_in']}→{r['date_out']} | {r['status']} | {r['staff']}")
    print("----------------")

def add_transaction(user):
    view_customers()
    cid = input("Customer ID: ")
    view_packages()
    pid = input("Package ID: ")
    weight = float(input("Weight (kg): "))

    conn = get_connection()
    cur = conn.cursor(dictionary=True)
    cur.execute("SELECT * FROM packages WHERE package_id=%s", (pid,))
    pkg = cur.fetchone()

    if not pkg:
        print("❌ Package not found.")
        return

    total = weight * float(pkg['price_per_kg'])
    date_in = datetime.date.today()
    date_out = date_in + datetime.timedelta(days=int(pkg['estimated_days']))

    cur2 = conn.cursor()
    cur2.execute("""
        INSERT INTO transactions (customer_id,package_id,weight_kg,total_price,date_in,date_out,status,input_user_id)
        VALUES (%s,%s,%s,%s,%s,%s,%s,%s)
    """, (cid,pid,weight,total,date_in,date_out,'received',user['user_id']))
    conn.commit()
    cur2.close()
    conn.close()

    print(f"✅ Transaction added! Total = Rp{total}")
    view_transactions()

